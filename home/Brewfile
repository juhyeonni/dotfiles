# On Intel Macs Homebrew has no prebuilt bottles, so these come from mise instead
# (home/dot_config/mise/config.toml). Casks are prebuilt either way.
unless Hardware::CPU.intel?
  brew "chezmoi"
  brew "herdr"
  brew "neovim"
  brew "jq"
  brew "fzf"
  brew "fd"
  brew "ripgrep"
  brew "bat"
  brew "eza"
  brew "lazygit"
  brew "zoxide"
  brew "ghq"
  brew "tree-sitter-cli"
  brew "git-lfs"
  brew "gh"
  brew "mas"
end

cask "ghostty"
cask "karabiner-elements"
cask "hammerspoon"
cask "alfred"
cask "jordanbaird-ice@beta" # the beta runs on macOS 27; the stable cask is older
cask "linearmouse"
cask "keka"
cask "iina"

# Charge limiting only matters on Macs with a battery
cask "aldente" if `pmset -g batt`.include?("InternalBattery")

# App Store apps need `mas` and a signed-in App Store account
mas "Magnet", id: 441258766
