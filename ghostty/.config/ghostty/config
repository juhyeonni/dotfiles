# ==============================================
#  Theme
# ==============================================
theme = Kanagawa Dragon

# ==============================================
#  Font
# ==============================================
font-family = MuxJK
font-size = 14
font-thicken = true
adjust-cell-height = 1

# ==============================================
#  Window
# ==============================================
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
background-opacity = 0.92
background-blur = 16
macos-titlebar-style = hidden

# ==============================================
#  Cursor
# ==============================================
cursor-style = block
cursor-style-blink = false

# ==============================================
#  Mouse
# ==============================================
mouse-hide-while-typing = true

# ==============================================
#  Shell Integration
# ==============================================
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ==============================================
#  Clipboard
# ==============================================
copy-on-select = clipboard
clipboard-read = ask
clipboard-paste-protection = false

# ==============================================
#  Misc
# ==============================================
confirm-close-surface = false
macos-option-as-alt = true
scrollback-limit = 100000
title-report = false

# Restore window/tab state
window-save-state = always

# On BEL: bounce the Dock icon, play a sound, and mark the title
bell-features = system, attention, title

# ==============================================
#  Keybindings
# ==============================================
keybind = cmd+shift+r=reload_config

# Keep the prefix working while the Korean IME is active: ignore layout/IME and match the
# physical key position (W3C KeyA)
keybind = ctrl+key_a=text:\x01

# herdr integration (\x01 = ctrl+a = herdr prefix)
# cmd+w maps to close_workspace because close_tab has no confirmation prompt and would
# silently destroy a space that has only one tab.
keybind = cmd+t=text:\x01c
keybind = cmd+w=text:\x01D
keybind = ctrl+tab=text:\x01n
keybind = ctrl+shift+tab=text:\x01p

# Shift+Enter → newline (sends Alt+Enter sequence)
keybind = shift+enter=text:\x1b\x0d

# Prompt jump (shell integration)
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

# Quick terminal (drops down over any app; needs macOS Accessibility permission)
# .zshrc skips auto-attach when it sees GHOSTTY_QUICK_TERMINAL
# cmd+` collides with the macOS "next window in app" default, so cmd+escape is used
keybind = global:cmd+escape=toggle_quick_terminal
