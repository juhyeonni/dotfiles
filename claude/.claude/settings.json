{
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "basic-memory@basicmachines-co": true,
    "red-team@anesis-dx": true,
    "annotated-ui-pdf@anesis-dx": true,
    "ponytail@ponytail": true,
    "document-skills@anthropic-agent-skills": true,
    "mattpocock-skills@mattpocock": true,
    "swift-lsp@claude-plugins-official": true,
    "macro-loop@juhyeonni": true,
    "macro-loop-band@juhyeonni": true,
    "humanizer@humanizer": true
  },
  "extraKnownMarketplaces": {
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "basicmachines-co": {
      "source": {
        "source": "github",
        "repo": "basicmachines-co/basic-memory",
        "sparsePaths": [
          ".claude-plugin",
          "plugins/claude-code"
        ]
      }
    },
    "anesis-dx": {
      "source": {
        "source": "github",
        "repo": "anesis-dx/claude-code-plugins"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "mattpocock": {
      "source": {
        "source": "git",
        "url": "https://github.com/mattpocock/skills.git"
      }
    },
    "juhyeonni": {
      "source": {
        "source": "github",
        "repo": "juhyeonni/cc-plugins"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
