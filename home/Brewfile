  brew "herdr"
  brew "neovim"
  brew "jq"
  brew "fzf"
  brew "fd"
  brew "ripgrep"
  brew "bat"
  brew "eza"
  brew "lazygit"
  brew "zoxide"
  brew "ghq"
  brew "tree-sitter-cli"
  brew "git-lfs"
  brew "gh"
end

cask "ghostty"
