# nvim docs stay in the repo; deploying them to ~/.config/nvim buys nothing
.config/nvim/README.md
.config/nvim/REQUIREMENTS.md

# only the install script reads the Brewfile; it is not deployed to ~/Brewfile
Brewfile

# per-machine nvim settings stay out of the repo, so a later `chezmoi add` must not deploy it
.config/nvim/lua/plugins/local.lua

# mise replaces the CLI brews only on Intel, where Homebrew has no prebuilt bottles
{{ if ne .chezmoi.arch "amd64" }}
.config/mise
{{ end }}
